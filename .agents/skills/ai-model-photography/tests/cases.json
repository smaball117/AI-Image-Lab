{
  "schema_version": "1.0",
  "skill": "ai-model-photography",
  "note": "Fixtures test the dispatch/intended behavior. They do not certify that Codex or an image generator actually complies.",
  "cases": [
    {
      "id": "T01",
      "trigger": true,
      "mode": "new",
      "user_prompt": "为12岁男童纯棉家居服做一张自然坐在沙发上的电商模特图，正面衣服完整清晰。",
      "expected_focus": [
        "age_appropriate",
        "pose_contact",
        "garment_fidelity"
      ],
      "must_not": [
        "adult_skin_defaults",
        "invent_bed"
      ]
    },
    {
      "id": "T02",
      "trigger": true,
      "mode": "reference",
      "user_prompt": "图1客厅沙发场景，图2模特脸，图3衣服，保留图1光影，换成自然坐姿，3:4单图。",
      "expected_focus": [
        "image_role_map",
        "identity_lock",
        "lighting_lock",
        "garment_fidelity"
      ],
      "must_not": [
        "cross_reference_leakage",
        "contact_sheet_output"
      ]
    },
    {
      "id": "T03",
      "trigger": true,
      "mode": "repair",
      "user_prompt": "只修复图1人物的面部结构，五官参考图2，光线、姿态、服装、背景和原比例都不动。",
      "expected_focus": [
        "face_only_patch",
        "scene_lock",
        "lighting_lock"
      ],
      "must_not": [
        "full_scene_rewrite",
        "face_grid"
      ]
    },
    {
      "id": "T04",
      "trigger": true,
      "mode": "repair",
      "user_prompt": "模特皮肤像塑料，其他构图和衣服已经很好。帮我只修复真实皮肤质感。",
      "expected_focus": [
        "skin_texture",
        "single_variable_repair"
      ],
      "must_not": [
        "redesign_outfit",
        "change_camera"
      ]
    },
    {
      "id": "T05",
      "trigger": true,
      "mode": "new",
      "user_prompt": "做一张成人美妆模特广告肖像，近景，明亮干净但不要平光和蜡像皮肤。",
      "expected_focus": [
        "portrait_camera",
        "skin_texture",
        "lighting_coherence"
      ],
      "must_not": [
        "mandatory_85mm",
        "mandatory_1_to_2_ratio"
      ]
    },
    {
      "id": "T06",
      "trigger": true,
      "mode": "reference",
      "user_prompt": "图1沙发场景，图2女孩脸，图3人物身材比例，图4服装。只用各图指定属性，女孩自然坐在沙发上。",
      "expected_focus": [
        "role_isolation",
        "pose_contact",
        "outfit_lock"
      ],
      "must_not": [
        "inherit_pose_reference_clothes",
        "invent_extra_furniture"
      ]
    },
    {
      "id": "T07",
      "trigger": false,
      "mode": "route_out",
      "user_prompt": "一瓶护肤精华静物产品，做玻璃材质反推和产品修图，画面没有人物。",
      "expected_focus": [
